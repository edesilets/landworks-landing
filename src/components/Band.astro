<div class="band">
  <div class="band-inner">
    <span class="band-item">Bellingham &amp; Surrounding Communities</span>
    <span class="band-dot"></span>
    <span class="band-item">Licensed &amp; Insured</span>
    <span class="band-dot"></span>
    <span class="band-item">Free Estimates</span>
    <span class="band-dot"></span>
    <span class="band-item">Residential &amp; Commercial</span>
  </div>
</div>

<style>
  .band {
    background: var(--amber);
    padding: 0 48px;
    display: flex;
    align-items: center;
    justify-content: center;
    overflow: hidden;
  }
  .band-inner {
    display: flex;
    align-items: center;
    padding: 20px 0;
    white-space: nowrap;
  }
  .band-item {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.3rem;
    letter-spacing: 0.12em;
    color: var(--navy);
    padding: 0 32px;
  }
  .band-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--navy);
    opacity: 0.35;
    flex-shrink: 0;
  }

  @media (max-width: 900px) {
    .band { padding: 0 24px; }
    .band-inner {
      flex-wrap: wrap;
      gap: 8px;
      padding: 16px 0;
      justify-content: center;
      white-space: normal;
    }
    .band-item { font-size: 1.1rem; padding: 0 16px; }
  }
</style>
