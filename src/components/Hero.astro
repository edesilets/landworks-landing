---
---

<section class="hero" id="home">
  <div class="hero-bg"></div>
  <div class="hero-noise"></div>
  <div class="hero-inner">
    <div class="hero-text">
      <div class="hero-eyebrow anim d1">Bellingham, Massachusetts</div>
      <h1 class="hero-headline anim d2">
        Land Cleared.<br />
        Site <em>Ready.</em><br />
        Work Done.
      </h1>
      <p class="hero-sub anim d3">
        Desilets Landworks LLC delivers expert land clearing, site prep, snow removal, and material services throughout the Bellingham area.
      </p>
      <div class="hero-actions anim d4">
        <a href="#contact" class="btn-primary">Request a Quote</a>
        <a href="tel:5089667135" class="btn-call">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07A19.5 19.5 0 013.07 9a19.79 19.79 0 01-3.07-8.67A2 2 0 012 .18h3a2 2 0 012 1.72 12.84 12.84 0 00.7 2.81 2 2 0 01-.45 2.11L6.09 7.91a16 16 0 006 6l1.06-1.06a2 2 0 012.11-.45 12.84 12.84 0 002.81.7A2 2 0 0122 14.92z"/>
          </svg>
          (508) 966-7135
        </a>
      </div>
    </div>

    <div class="hero-logo-wrap">
      <img src="/Desilets-Graphic.svg" alt="Desilets Landworks LLC" />
    </div>
  </div>
  <div class="hero-cut"></div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    display: flex;
    align-items: center;
    background: var(--navy);
    overflow: hidden;
  }

  .hero-bg {
    position: absolute;
    inset: 0;
    background: linear-gradient(
      170deg,
      #0d1c35 0%,
      #162747 35%,
      #2a3a5c 55%,
      #3d2e1e 80%,
      #5c3a20 100%
    );
  }

  .hero-noise {
    position: absolute;
    inset: 0;
    background-image: url("data:image/svg+xml,%3Csvg viewBox='0 0 200 200' xmlns='http://www.w3.org/2000/svg'%3E%3Cfilter id='n'%3E%3CfeTurbulence type='fractalNoise' baseFrequency='0.75' numOctaves='4' stitchTiles='stitch'/%3E%3C/filter%3E%3Crect width='100%25' height='100%25' filter='url(%23n)'/%3E%3C/svg%3E");
    opacity: 0.05;
    pointer-events: none;
  }

  .hero-cut {
    position: absolute;
    bottom: -1px; left: 0; right: 0;
    height: 100px;
    background: var(--cream);
    clip-path: polygon(0 100%, 100% 15%, 100% 100%);
    z-index: 2;
  }

  .hero-inner {
    position: relative;
    z-index: 3;
    max-width: 1280px;
    margin: 0 auto;
    width: 100%;
    padding: 120px 48px 140px;
    display: grid;
    grid-template-columns: 1fr 480px;
    gap: 48px;
    align-items: center;
  }

  .hero-eyebrow {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--amber);
    margin-bottom: 20px;
  }
  .hero-eyebrow::before {
    content: '';
    display: block;
    width: 28px;
    height: 2px;
    background: var(--amber);
  }

  .hero-headline {
    font-family: 'Bebas Neue', sans-serif;
    font-size: clamp(3.8rem, 7.5vw, 6.5rem);
    line-height: 0.93;
    letter-spacing: 0.02em;
    color: var(--white);
    margin-bottom: 28px;
  }
  .hero-headline em {
    font-style: normal;
    color: var(--amber);
  }

  .hero-sub {
    font-size: 1.05rem;
    line-height: 1.75;
    color: rgba(255,255,255,0.62);
    max-width: 500px;
    margin-bottom: 48px;
  }

  .hero-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
    align-items: center;
  }

  .btn-primary {
    display: inline-block;
    padding: 16px 36px;
    background: var(--amber);
    color: var(--navy);
    font-weight: 700;
    font-size: 0.88rem;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    text-decoration: none;
    border-radius: 2px;
    transition: background 0.2s, transform 0.15s, box-shadow 0.2s;
  }
  .btn-primary:hover {
    background: var(--white);
    transform: translateY(-2px);
    box-shadow: 0 10px 28px rgba(0,0,0,0.35);
  }

  .btn-call {
    display: inline-flex;
    align-items: center;
    gap: 9px;
    color: rgba(255,255,255,0.68);
    font-size: 0.98rem;
    font-weight: 500;
    text-decoration: none;
    transition: color 0.2s;
  }
  .btn-call:hover { color: var(--amber); }
  .btn-call svg { width: 17px; height: 17px; flex-shrink: 0; }

  .hero-logo-wrap {
    display: flex;
    align-items: center;
    justify-content: center;
  }
  .hero-logo-wrap img {
    width: 100%;
    max-width: 460px;
    height: auto;
    filter: drop-shadow(0 20px 60px rgba(0,0,0,0.5));
    animation: floatIn 0.9s cubic-bezier(0.22,1,0.36,1) both;
    animation-delay: 0.3s;
  }

  @media (max-width: 900px) {
    .hero-inner {
      grid-template-columns: 1fr;
      padding: 100px 24px 100px;
      gap: 32px;
    }
    .hero-logo-wrap img { max-width: 300px; margin: 0 auto; }
    .hero-headline { font-size: clamp(3rem, 10vw, 4.5rem); }
    .hero-sub { font-size: 0.95rem; }
    .btn-primary { padding: 14px 28px; font-size: 0.82rem; }
  }

  @media (max-width: 520px) {
    .hero-logo-wrap img { max-width: 260px; }
    .hero-headline { font-size: 3rem; }
  }
</style>
