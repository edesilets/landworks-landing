---
---

<section class="services" id="services">
  <div class="section-header">
    <div class="section-eyebrow">What We Do</div>
    <h2 class="section-title">Our Services</h2>
  </div>
  <div class="services-grid">

    <div class="service-card">
      <div class="svc-num">01</div>
      <svg class="svc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M17 8l-5-5-5 5M12 3v14"/><path d="M3 19h18"/>
      </svg>
      <div class="svc-name">Land Clearing</div>
      <p class="svc-desc">Trees, brush, stumps, and debris — we clear the land so your project can move forward.</p>
    </div>

    <div class="service-card">
      <div class="svc-num">02</div>
      <svg class="svc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <rect x="3" y="3" width="18" height="18" rx="2"/><path d="M3 9h18M9 21V9"/>
      </svg>
      <div class="svc-name">Site Prep</div>
      <p class="svc-desc">Grading, leveling, and shaping land for construction, landscaping, or agricultural use.</p>
    </div>

    <div class="service-card">
      <div class="svc-num">03</div>
      <svg class="svc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M2 12h20M6 8l-4 4 4 4M18 8l4 4-4 4"/><path d="M12 2v4M12 18v4"/>
      </svg>
      <div class="svc-name">Snow Removal</div>
      <p class="svc-desc">Reliable, prompt snow and ice management through every New England winter.</p>
    </div>

    <div class="service-card">
      <div class="svc-num">04</div>
      <svg class="svc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M1 3h15v13H1zM16 8h4l3 3v5h-7V8z"/><circle cx="5.5" cy="18.5" r="2.5"/><circle cx="18.5" cy="18.5" r="2.5"/>
      </svg>
      <div class="svc-name">Dump Trailer Services</div>
      <p class="svc-desc">Debris, fill, or job-site waste — hauled away efficiently so your cleanup is stress-free.</p>
    </div>

    <div class="service-card">
      <div class="svc-num">05</div>
      <svg class="svc-icon" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
        <path d="M5 17H3a2 2 0 01-2-2V5a2 2 0 012-2h11a2 2 0 012 2v3"/><rect x="9" y="11" width="14" height="10" rx="1"/><path d="M13 15h4M13 19h4M17 11v10"/>
      </svg>
      <div class="svc-name">Material Delivery</div>
      <p class="svc-desc">Gravel, loam, mulch and more delivered directly to your site when you need it.</p>
    </div>

  </div>
</section>

<style>
  .services {
    background: var(--cream);
    padding: 96px 48px 80px;
  }

  .services-grid {
    max-width: 1200px;
    margin: 0 auto;
    display: grid;
    grid-template-columns: repeat(5, 1fr);
    gap: 3px;
  }

  .service-card {
    background: var(--navy);
    padding: 44px 32px 40px;
    position: relative;
    overflow: hidden;
    transition: background 0.3s, transform 0.25s;
    cursor: default;
  }
  .service-card:nth-child(2) { background: #1e3256; }
  .service-card:nth-child(3) { background: #243a60; }
  .service-card:nth-child(4) { background: #1a2f50; }
  .service-card:nth-child(5) { background: #1c2e4a; }
  .service-card:hover {
    background: var(--brown-dark) !important;
    transform: translateY(-4px);
    z-index: 2;
  }

  .service-card::after {
    content: '';
    position: absolute;
    bottom: 0; left: 0; right: 0;
    height: 3px;
    background: var(--amber);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 0.35s cubic-bezier(0.22,1,0.36,1);
  }
  .service-card:hover::after { transform: scaleX(1); }

  .svc-num {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 2.8rem;
    color: rgba(255,255,255,0.1);
    line-height: 1;
    margin-bottom: 16px;
    transition: color 0.3s;
  }
  .service-card:hover .svc-num { color: var(--amber); opacity: 0.6; }

  .svc-icon {
    width: 36px;
    height: 36px;
    margin-bottom: 18px;
    color: var(--amber);
  }

  .svc-name {
    font-family: 'Bebas Neue', sans-serif;
    font-size: 1.5rem;
    letter-spacing: 0.04em;
    color: var(--white);
    margin-bottom: 12px;
    line-height: 1;
  }
  .svc-desc {
    font-size: 0.85rem;
    line-height: 1.65;
    color: rgba(255,255,255,0.55);
  }

  @media (max-width: 900px) {
    .services { padding: 72px 24px 60px; }
    .services-grid {
      grid-template-columns: 1fr 1fr;
      gap: 3px;
    }
    .service-card:nth-child(5) { grid-column: span 2; }
  }

  @media (max-width: 520px) {
    .services-grid { grid-template-columns: 1fr; }
    .service-card:nth-child(5) { grid-column: span 1; }
  }
</style>
